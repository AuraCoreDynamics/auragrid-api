      "CellConfigValueRequest": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": {}
        }
      },
      "CellConfigValueResponse": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "key": { "type": ["string", "null"] },
          "value": {}
        }
      },
      "RemovedResponse": {
