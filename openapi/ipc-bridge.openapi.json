          "nodeId": { "type": "string" },
          "hostName": { "type": ["string", "null"] },
          "state": { "type": "string" },
          "address": { "type": ["string", "null"] },
          "joinedAt": { "type": ["string", "null"], "format": "date-time" },
          "lastHeartbeat": { "type": "string", "format": "date-time" },
          "registeredServices": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "metadata": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "string" }
          },
          "incarnation": { "type": "integer", "minimum": 0 }
        }
      },
      "CellMembersResponse": {
        "type": "object",
        "required": ["members"],
        "properties": {
          "members": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CellMember" }
          }
        }
      },
      "HealthyCountResponse": {
        "type": "object",
        "required": ["count"],
        "properties": {
          "count": { "type": "integer", "minimum": 0 }
        }
      },
      "CellMembershipMetadata": {
        "type": "object",
        "required": ["healthyCount", "totalCount", "lastUpdated", "incarnationNumber"],
