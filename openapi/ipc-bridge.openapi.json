      "HealthStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string" },
          "nodeId": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] }
        }
      },
      "CellConfigMetadata": {
        "type": "object",
