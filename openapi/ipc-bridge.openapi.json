      "LeaseRenewResponse": {
        "type": "object",
        "required": ["extended"],
        "properties": {
          "extended": { "type": "boolean" },
          "conflict": {
            "oneOf": [
              { "$ref": "#/components/schemas/LeaseConflictDto" },
              { "type": "null" }
            ]
          }
        }
      },
      "LeaseReleaseRequest": {
        "type": "object",
        "required": ["masId", "fencingToken"],
        "properties": {
          "masId": { "type": "string" },
          "fencingToken": { "type": "integer", "minimum": 1 }
        }
      },
      "LeaseMarkerResponse": {
        "type": "object",
        "required": ["marker"],
        "properties": {
          "marker": {
            "oneOf": [
              { "$ref": "#/components/schemas/WalMarker" },
              { "type": "null" }
            ]
          }
        }
      },
      "VolunteerToggleRequest": {
        "type": "object",
        "required": ["masId", "enabled"],
        "properties": {
          "masId": { "type": "string" },
          "enabled": { "type": "boolean" },
          "user": { "type": ["string", "null"] }
        }
      },
      "ClaimWorkBatchRequest": {
        "type": "object",
        "required": ["masId", "itemIds"],
        "properties": {
          "masId": { "type": "string" },
          "itemIds": { "type": "array", "items": { "type": "string" } },
          "ttlSeconds": { "type": "number", "default": 60.0 }
        }
      },
      "CommitWorkBatchRequest": {
        "type": "object",
        "required": ["fencingToken"],
        "properties": {
          "fencingToken": { "type": "integer", "minimum": 1 },
          "checkpointMetadata": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "WorkBatchClaimDto": {
        "type": "object",
        "required": [
          "batchId",
          "masId",
          "claimedByNodeId",
          "claimedByUser",
          "claimedAtUtc",
          "expiresAtUtc",
          "itemIds",
          "status"
        ],
        "properties": {
          "batchId": { "type": "string" },
          "masId": { "type": "string" },
          "claimedByNodeId": { "type": "string" },
          "claimedByUser": { "type": "string" },
          "claimedAtUtc": { "type": "string", "format": "date-time" },
          "expiresAtUtc": { "type": "string", "format": "date-time" },
          "itemIds": { "type": "array", "items": { "type": "string" } },
          "status": {
            "type": "string",
            "enum": ["Claimed", "Staged", "Committed", "Abandoned"]
          },
          "fencingToken": { "type": ["integer", "null"] },
          "checkpointMetadata": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "ConflictsResponse": {
        "type": "object",
