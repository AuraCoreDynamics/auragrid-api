          "openApiEndpoint": { "type": ["string", "null"] },
          "mcpEndpoint": { "type": ["string", "null"] },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "metadata": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "DiscoverEndpointsResponse": {
        "type": "object",
