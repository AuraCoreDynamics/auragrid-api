          "userId": { "type": ["string", "null"] },
          "action": { "type": "string" },
          "resourceId": { "type": ["string", "null"] },
          "permitted": { "type": "boolean" },
          "source": { "type": ["string", "null"] }
        }
      },
      "TopicsResponse": {
        "type": "object",
        "required": ["topics"],
        "properties": {
          "topics": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ExistsResponse": {
        "type": "object",
        "required": ["exists"],
        "properties": {
          "exists": { "type": "boolean" }
        }
      },
      "WalMarker": {
        "type": "object",
