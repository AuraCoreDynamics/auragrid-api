          "incarnationNumber": { "type": "integer", "minimum": 0 },
          "protocol": { "type": ["string", "null"] }
        }
      },
      "GovernanceAppRequest": {
        "type": "object",
        "required": ["appId"],
        "properties": {
          "appId": { "type": "string" },
          "userId": { "type": ["string", "null"] }
        }
      },
      "GovernanceResourceRequest": {
        "type": "object",
