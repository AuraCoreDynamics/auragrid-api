{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auragrid.io/schemas/service-descriptor.schema.json",
  "title": "AuraGrid Python MAS Service Descriptor",
  "description": "Canonical intermediate representation generated by auragrid.descriptor and consumed by AuraGrid PythonServiceDescriptorLoader / Protobuf / OpenAPI generators.",
  "type": "object",
  "required": ["serviceName", "sourceTypeName", "methods"],
  "additionalProperties": false,
  "properties": {
    "serviceName": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "sourceTypeName": { "type": "string", "minLength": 1 },
    "methods": {
      "type": "array",
      "items": { "$ref": "#/definitions/methodDescriptor" }
    }
  },
  "definitions": {
    "typeDescriptor": {
      "type": "object",
      "required": ["clrTypeName", "protoType", "openApiType"],
      "additionalProperties": false,
      "properties": {
        "clrTypeName": { "type": "string", "minLength": 1 },
        "protoType": { "type": "string", "minLength": 1 },
        "openApiType": { "type": "string", "minLength": 1 },
        "openApiFormat": { "type": ["string", "null"] },
        "isCollection": { "type": "boolean", "default": false },
        "elementType": {
          "oneOf": [
            { "$ref": "#/definitions/typeDescriptor" },
            { "type": "null" }
          ]
        },
        "isVoid": { "type": "boolean", "default": false }
      }
    },
    "parameterDescriptor": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/definitions/typeDescriptor" },
        "isOptional": { "type": "boolean", "default": false }
      }
    },
    "methodDescriptor": {
      "type": "object",
      "required": ["methodName", "parameters", "returnType"],
      "additionalProperties": false,
      "properties": {
        "methodName": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/parameterDescriptor" }
        },
        "returnType": { "$ref": "#/definitions/typeDescriptor" },
        "requiredRole": { "type": ["string", "null"] },
        "requiredClaim": { "type": ["string", "null"] }
      }
    }
  }
}
