{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auragrid.io/schemas/app.manifest.schema.json",
  "title": "AuraGrid & AuraSprout Application Manifest",
  "description": "Canonical application package manifest shared across AuraGrid and AuraSprout.",
  "type": "object",
  "required": ["appId", "name", "version", "services"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema URI for editor IntelliSense and validation."
    },
    "appId": {
      "type": "string",
      "description": "Unique identifier for the application (e.g., 'sovereign-beacon', 'model-foundry').",
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name of the application."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic version string (e.g., '1.0.0')."
    },
    "description": {
      "type": "string",
      "description": "Summary of the application workload and responsibilities."
    },
    "websiteUrl": {
      "type": "string",
      "format": "uri",
      "description": "Optional project or documentation website URL."
    },
    "repositoryUrl": {
      "type": "string",
      "description": "Optional source code repository URL or git URN (e.g. https://github.com/... or git@...)."
    },
    "installer": { "$ref": "#/definitions/executableDefinition" },
    "startup": { "$ref": "#/definitions/executableDefinition" },
    "shutdown": { "$ref": "#/definitions/executableDefinition" },
    "uninstall": { "$ref": "#/definitions/executableDefinition" },
    "services": {
      "type": "array",
      "description": "Managed Application Services (MAS) belonging to this application.",
      "items": { "$ref": "#/definitions/masDefinition" }
    },
    "guiEntryPoints": {
      "type": "array",
      "description": "Desktop/GUI entrypoints for interactive user execution.",
      "items": { "$ref": "#/definitions/guiEntryPoint" }
    },
    "providesContracts": {
      "type": "array",
      "items": { "$ref": "#/definitions/providedContract" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/definitions/contractDependency" }
    },
    "distribution": { "$ref": "#/definitions/distributionConfig" },
    "observability": { "$ref": "#/definitions/observabilityConfig" }
  },
  "definitions": {
    "masMode": {
      "type": "string",
      "enum": ["LocalOnly", "CellSingleton", "Distributed"],
      "description": "Unified placement mode: LocalOnly (node-managed only), CellSingleton (leased 1-of-N with fencing token), or Distributed (all-of-N cooperative processing)."
    },
    "executionRuntime": {
      "type": "string",
      "enum": ["Python", "Container", "CSharp", "PowerShell", "Wasm"],
      "description": "Execution harness used to run a MAS or GUI entrypoint."
    },
    "executableDefinition": {
      "type": "object",
      "required": ["context", "entryCommand"],
      "additionalProperties": false,
      "properties": {
        "context": { "$ref": "#/definitions/executionRuntime" },
        "entryCommand": { "type": "string", "minLength": 1 },
        "arguments": { "type": "string" },
        "workingDirectory": { "type": "string" },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "managedVenv": { "type": "string" }
      }
    },
    "guiEntryPoint": {
      "type": "object",
      "required": ["name", "context", "entryCommand"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "iconPath": { "type": "string" },
        "context": { "$ref": "#/definitions/executionRuntime" },
        "entryCommand": { "type": "string", "minLength": 1 }
      }
    },
    "providedContract": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "contractDependency": {
      "type": "object",
      "required": ["contractId", "version"],
      "additionalProperties": false,
      "properties": {
        "contractId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "preferredImplementationAppId": { "type": "string" }
      }
    },
    "remotingConfig": {
      "type": "object",
      "description": "RPC, REST, and MCP service dispatch exposure configuration.",
      "additionalProperties": false,
      "properties": {
        "enableGrpc": { "type": "boolean", "default": true },
        "enableOpenApi": { "type": "boolean", "default": true },
        "enableMcp": { "type": "boolean", "default": true }
      }
    },
    "pythonMasConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scriptPath": { "type": "string" },
        "arguments": { "type": "string" },
        "pythonExecutable": { "type": "string", "default": "python" },
        "managedVenv": { "type": "string" }
      }
    },
    "containerMasConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "ports": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "memoryLimitMb": { "type": "integer", "minimum": 1 },
        "cpuShares": { "type": "integer", "minimum": 1 }
      }
    },
    "csharpMasConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assemblyPath": { "type": "string", "minLength": 1 },
        "typeName": { "type": "string", "minLength": 1 }
      }
    },
    "powerShellMasConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scriptPath": { "type": "string", "minLength": 1 },
        "arguments": { "type": "string" }
      }
    },
    "masDefinition": {
      "type": "object",
      "required": ["masId", "mode", "runtime"],
      "additionalProperties": false,
      "properties": {
        "masId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "displayName": { "type": "string" },
        "mode": { "$ref": "#/definitions/masMode" },
        "runtime": { "$ref": "#/definitions/executionRuntime" },
        "restartPolicy": {
          "type": "string",
          "enum": ["Always", "OnFailure", "Never"],
          "default": "OnFailure"
        },
        "maxRestartAttempts": { "type": "integer", "default": 3, "minimum": 0 },
        "workingDirectory": { "type": "string" },
        "manifestDirectory": { "type": "string" },
        "preferredInstructionSets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadataRequirements": {
          "type": "object",
          "description": "Capability affinity constraints such as 'gpu.vram.gb': '>=24' or 'cpu.avx2': 'true'.",
          "additionalProperties": { "type": "string" }
        },
        "appraisalThreshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "remoting": { "$ref": "#/definitions/remotingConfig" },
        "pythonConfig": { "$ref": "#/definitions/pythonMasConfig" },
        "containerConfig": { "$ref": "#/definitions/containerMasConfig" },
        "cSharpConfig": { "$ref": "#/definitions/csharpMasConfig" },
        "csharpConfig": { "$ref": "#/definitions/csharpMasConfig" },
        "powerShellConfig": { "$ref": "#/definitions/powerShellMasConfig" }
      }
    },
    "distributionConfig": {
      "type": "object",
      "description": "Optional user-space packaging and catalog distribution metadata for AuraSprout.",
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "array",
          "items": { "type": "string", "enum": ["stable", "preview", "canary", "nightly"] }
        },
        "wheelhousePath": { "type": "string" },
        "subprojects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pipInstallArgs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "postInstallCommands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skills": {
          "type": "array",
          "description": "Relative paths to agentic skill directories (containing SKILL.md) or SKILL.md files bundled with this application.",
          "items": { "type": "string" }
        },
        "hooks": {
          "type": "object",
          "properties": {
            "preInstall": { "type": "string" },
            "postInstall": { "type": "string" },
            "preUninstall": { "type": "string" },
            "postUninstall": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "entrypointCommand": { "type": "string" },
        "defaultPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "defaultDest": { "type": "string" },
        "createDesktopShortcut": { "type": "boolean", "default": true },
        "createLaunchers": { "type": "boolean", "default": true },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sloConfig": {
      "type": "object",
      "description": "Service-level objective thresholds for startup, endpoint latency, RSS memory, and restart counts.",
      "additionalProperties": false,
      "properties": {
        "maxStartupMs": { "type": "number", "exclusiveMinimum": 0 },
        "maxEndpointLatencyMs": { "type": "number", "exclusiveMinimum": 0 },
        "maxRssMb": { "type": "number", "exclusiveMinimum": 0 },
        "maxRestartCount": { "type": "integer", "minimum": 0 }
      }
    },
    "observabilityConfig": {
      "type": "object",
      "description": "Optional DevSecOps runtime telemetry, SLO thresholds, and automated triage policy.",
      "additionalProperties": false,
      "properties": {
        "slo": { "$ref": "#/definitions/sloConfig" },
        "triagePolicy": {
          "type": "string",
          "enum": ["SUPERVISED", "BOUNDED_AUTONOMOUS"],
          "default": "SUPERVISED"
        },
        "logRingLines": {
          "type": "integer",
          "minimum": 10,
          "maximum": 10000,
          "default": 200
        }
      }
    }
  }
}
