{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auragrid.io/schemas/catalog.schema.json",
  "title": "AuraCore Unified Application Catalog Schema",
  "description": "Canonical catalog manifest schema unifying web/shared-FS AuraSprout catalogs (.apkg/wheelhouse/SHA-256) and AuraGrid CatalogChannelReconciler entries.",
  "type": "object",
  "required": ["catalogName", "version", "updatedAt", "apps"],
  "additionalProperties": false,
  "properties": {
    "catalogName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": ["string", "null"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "apps": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/catalogAppEntry" }
    },
    "attachedSources": {
      "type": "array",
      "items": { "$ref": "#/definitions/attachedCatalogSource" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "definitions": {
    "releaseChannel": {
      "type": "string",
      "enum": ["stable", "preview", "canary", "nightly"]
    },
    "attachedCatalogSource": {
      "type": "object",
      "required": ["url", "label", "isDefault"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "isDefault": { "type": "boolean" }
      }
    },
    "appVersionEntry": {
      "type": "object",
      "required": ["version", "releaseDate", "bundleFilename", "bundleSha256", "bundleSizeBytes"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "channel": { "$ref": "#/definitions/releaseChannel" },
        "releaseDate": { "type": "string", "format": "date-time" },
        "bundleFilename": { "type": "string", "minLength": 1 },
        "bundleUrl": { "type": "string" },
        "bundleSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "bundleSizeBytes": { "type": "integer", "minimum": 0 },
        "manifestSha256": { "type": "string" },
        "manifestUri": { "type": "string" },
        "entrypointCommand": { "type": "string" },
        "defaultPort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
        "wheelhousePath": { "type": ["string", "null"] },
        "deltaFromVersion": { "type": ["string", "null"] },
        "subprojects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "changelog": { "type": "string" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "catalogAppEntry": {
      "type": "object",
      "required": ["appId", "name", "displayName", "latestVersion", "versions"],
      "additionalProperties": false,
      "properties": {
        "appId": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "repositoryUrl": { "type": "string" },
        "latestVersion": { "type": "string", "minLength": 1 },
        "channel": { "$ref": "#/definitions/releaseChannel" },
        "manifestUri": { "type": ["string", "null"] },
        "isDefault": { "type": "boolean", "default": false },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "versions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/appVersionEntry" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
